# ---------------------------------------------------------------------------
# Plantilla de variables de entorno del proyecto.
# Copia este archivo a `.env` (ignorado por Git) o exporta las variables en tu
# shell. Las variables ya presentes en el entorno tienen prioridad sobre `.env`.
#
# En GitHub Actions no se usa `.env`: estas variables se configuran en
# Settings -> Secrets and variables -> Actions (ver comentario de cada una).
# ---------------------------------------------------------------------------

# Token de GitHub (eleva el límite de la API; usado por el Miner).
# El Reporter NO lo usa. En Actions se usa el GITHUB_TOKEN automático del run.
GITHUB_TOKEN=

# Clave del proveedor LLM (usada por el Reporter). Si falta, el Reporter
# genera el reporte en modo determinista (fallback).
# En Actions: Repository Secret `LLM_API_KEY`.
LLM_API_KEY=

# Endpoint compatible con la API de OpenAI (por defecto, OpenAI).
# En Actions: Repository Variable `LLM_BASE_URL`.
LLM_BASE_URL=https://api.openai.com/v1

# Modelo a usar (por defecto, gpt-4o-mini).
# En Actions: Repository Variable `LLM_MODEL`.
LLM_MODEL=gpt-4o-mini

# Timeout en segundos para las llamadas al LLM.
# En Actions: Repository Variable `LLM_TIMEOUT`.
LLM_TIMEOUT=60
